{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "projects": {
        "ClusterId": "projects",
        "Match": { "Path": "/api/projects/{**catch-all}" }
      },
      "projects-root": {
        "ClusterId": "projects",
        "Match": { "Path": "/api/projects" }
      },
      "tasks": {
        "ClusterId": "tasks",
        "Match": { "Path": "/api/tasks/{**catch-all}" }
      }
    },
    "Clusters": {
      "projects": {
        "Destinations": {
          "projects-api": { "Address": "https+http://projects-api" }
        }
      },
      "tasks": {
        "Destinations": {
          "tasks-api": { "Address": "https+http://tasks-api" }
        }
      }
    }
  }
}
